import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

# Temperature = 303 K

# Romulus - N2
P_Rom_N2 = np.array([
    2026.500, 3039.750, 4053.000, 6079.500, 8106.000, 61909.575, 111356.175, 173265.750, 247435.650, 321706.875, 395978.100, 470148.000, 544419.225, 618690.450
])
q_Rom_N2 = np.array([
    0.025, 0.038, 0.053, 0.079, 0.108, 0.562, 0.835, 1.082, 1.295, 1.482, 1.597, 1.714, 1.795, 1.861
])

y_Rom_N2=P_Rom_N2/q_Rom_N2

coeff_Rom_N2 = np.polyfit(P_Rom_N2, y_Rom_N2, 1)
poly_Rom_N2 = np.poly1d(coeff_Rom_N2)
qmax_Rom_N2 = 1 / coeff_Rom_N2[0]
KL_Rom_N2 = coeff_Rom_N2[0] / coeff_Rom_N2[1]
q_pred_Rom_N2 = poly_Rom_N2(P_Rom_N2)
r2_Rom_N2 = 1 - np.sum((y_Rom_N2 - q_pred_Rom_N2)**2) / np.sum((y_Rom_N2 - np.mean(y_Rom_N2))**2)

P_fit_Rom_N2 = [min(P_Rom_N2), max(P_Rom_N2)]
q_fit_Rom_N2 = poly_Rom_N2(P_fit_Rom_N2)

