import numpy as np
from scipy.integrate import solve_ivp
import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_csv('isotherm_data.csv')

def get_isotherm(adsorbent_name, adsorbate_name):
    subset = data[(data['Adsorbent'] == adsorbent_name) & (data['Adsorbate'] == adsorbate_name)]
    return subset['P_Pa'].values, subset['q_mol_kg'].values

P_Rom_N2, q_Rom_N2 = get_isotherm('Romulus', 'N2')
P_Rom_O2, q_Rom_O2 = get_isotherm('Romulus', 'O2')
P_Rem_N2, q_Rem_N2 = get_isotherm('Remus', 'N2')
P_Rem_O2, q_Rem_O2 = get_isotherm('Remus', 'O2')

P_q_Rom_N2 = P_Rom_N2[1:] / q_Rom_N2[1:]
P_q_Rom_O2 = P_Rom_O2[1:] / q_Rom_O2[1:]
P_q_Rem_N2 = P_Rem_N2[1:] / q_Rem_N2[1:]
P_q_Rem_O2 = P_Rem_O2[1:] / q_Rem_O2[1:]

slope, intercept = np.polyfit(P_Rom_N2[1:], P_q_Rom_N2, 1)

plt.figure(figsize = (8, 5))
plt.scatter(P_Rom_N2[1:], P_q_Rom_N2, label = 'Experimental Data')
plt.plot(P_Rom_N2[1:], slope * P_Rom_N2[1:] + intercept)
plt.show()

