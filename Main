import numpy as np
from scipy.integrate import solve_ivp
import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_csv('isotherm_data.csv')

def get_isotherm(adsorbent_name, adsorbate_name):
    subset = data[(data['Adsorbent'] == adsorbent_name) & (data['Adsorbate'] == adsorbate_name)]
    return subset['P_Pa'].values, subset['q_mol_kg'].values

P_Romulus_N2, q_Romulus_N2 = get_isotherm('Romulus', 'N2')
P_Romulus_O2, q_Romulus_O2 = get_isotherm('Romulus', 'O2')
P_Remus_N2, q_Remus_N2 = get_isotherm('Remus', 'N2')
P_Remus_O2, q_Remus_O2 = get_isotherm('Remus', 'O2')

